# Polymarket live execution test — credentials template
# Copy this file to .env and fill in your values.
# .env is gitignored; .env.example is NOT (template only, no real keys).

# Private key of the wallet that signs orders.
# For POLY_PROXY (signature_type=1) this is the EOA that owns the proxy.
# Format: hex string with or without 0x prefix.
POLYMARKET_PRIVATE_KEY=

# Polymarket proxy address (the address that actually holds funds and
# appears as "maker" on chain). For POLY_PROXY users this is your
# Magic.link / Polymarket proxy wallet address (0x...).
POLYMARKET_PROXY_ADDRESS=

# Funder address — for POLY_PROXY this is typically the SAME as
# POLYMARKET_PROXY_ADDRESS (the proxy is what funds the order). If you
# use a different deposit wallet flow, set it here.
POLYMARKET_FUNDER_ADDRESS=

# Polymarket CLOB API (L2) credentials — derived/generated from your wallet.
# These are read by the bot but NOT used in Phase 0 (presence-checked only).
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
